  "components": {
    "schemas": {
      "AssessmentRequest": {
        "required": [
          "reserveAmount",
          "currency",
          "notes"
        ],
        "type": "object",
        "properties": {
          "reserveAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClaimDetail": {
        "required": [
          "id",
          "claimNumber",
          "policyNumber",
          "claimantId",
          "productType",
          "market",
          "status",
          "incidentDate",
          "description",
          "claimedAmount",
          "maxPayable",
          "submittedAt",
          "decision",
          "timeline",
          "openInformationRequests"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claimNumber": {
            "type": "string"
          },
          "policyNumber": {
            "type": "string"
          },
          "claimantId": {
            "type": "string",
            "format": "uuid"
          },
          "productType": {
            "$ref": "#/components/schemas/ProductType"
          },
          "market": {
            "$ref": "#/components/schemas/Market"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "claimedAmount": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "maxPayable": {
            "$ref": "#/components/schemas/MoneyDto"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "decision": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DecisionDto"
              }
            ]
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusChangeDto"
            }
          },
          "openInformationRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InformationRequestDto"
            }
          }
        }
      },
      "ClaimStatus": {
        "enum": [
          "Submitted",
          "UnderReview",
          "AwaitingInformation",
          "Approved",
          "Rejected",
          "Settled"
        ]
      },
      "ClaimSummary": {
